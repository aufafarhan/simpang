# Normalisasi line ending (penting karena proyek dibuat di Windows)
* text=auto eol=lf

# File yang harus tetap CRLF / biner
*.bat        text eol=crlf
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
*.pdf        binary
*.zip        binary
